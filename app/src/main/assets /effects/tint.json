{
  "id": "tint",
  "name": "Tint",
  "params": [
    { "key": "black", "label": "Map Black To", "dims": 3, "default": [0, 0, 0], "min": 0, "max": 255, "step": 1 },
    { "key": "white", "label": "Map White To", "dims": 3, "default": [255, 255, 255], "min": 0, "max": 255, "step": 1 },
    { "key": "amount", "label": "Tint Amount", "dims": 1, "default": [100], "min": 0, "max": 100, "step": 0.5 }
  ],
  "pad": "0",
  "passes": [
    {
      "shader": "tint.frag",
      "when": "amount > 0",
      "uniforms": {
        "uBlack": ["black[0] / 255", "black[1] / 255", "black[2] / 255"],
        "uWhite": ["white[0] / 255", "white[1] / 255", "white[2] / 255"],
        "uAmount": ["amount / 100"]
      }
    }
  ]
}
