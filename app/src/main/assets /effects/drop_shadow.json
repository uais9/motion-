{
  "id": "drop_shadow",
  "name": "Drop Shadow",
  "params": [
    { "key": "color", "label": "Shadow Color", "dims": 3, "default": [0, 0, 0], "min": 0, "max": 255, "step": 1 },
    { "key": "opacity", "label": "Opacity", "dims": 1, "default": [50], "min": 0, "max": 100, "step": 0.5 },
    { "key": "direction", "label": "Direction", "dims": 1, "default": [135], "step": 0.8 },
    { "key": "distance", "label": "Distance", "dims": 1, "default": [5], "step": 0.5 },
    { "key": "softness", "label": "Softness", "dims": 1, "default": [5], "min": 0, "step": 0.5 },
    { "key": "only", "label": "Shadow Only", "dims": 1, "default": [0], "min": 0, "max": 1, "step": 0.05 }
  ],
  "pad": "abs(distance) + ceil(3 * softness / 2)",
  "passes": [
    {
      "shader": "drop_shadow_1.frag",
      "when": "opacity > 0",
      "uniforms": {
        "uStep": ["1 / workW", "0"],
        "uOffset": ["sin(radians(direction)) * distance / workW", "-cos(radians(direction)) * distance / workH"],
        "uSigma": ["softness / 2"]
      }
    },
    {
      "shader": "drop_shadow_2.frag",
      "when": "opacity > 0",
      "inputs": ["prev", "last"],
      "uniforms": {
        "uStep": ["0", "1 / workH"],
        "uSigma": ["softness / 2"],
        "uColor": ["color[0] / 255", "color[1] / 255", "color[2] / 255"],
        "uOpacity": ["opacity / 100"],
        "uOnly": ["only"]
      }
    }
  ]
}
