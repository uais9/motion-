{
  "id": "directional_blur",
  "name": "Directional Blur",
  "params": [
    { "key": "direction", "label": "Direction", "dims": 1, "default": [0], "step": 0.8 },
    { "key": "length", "label": "Blur Length", "dims": 1, "default": [0], "min": 0, "max": 4000, "step": 0.5 }
  ],
  "pad": "length / 2",
  "passes": [
    {
      "shader": "directional_blur.frag",
      "when": "length > 0.01",
      "uniforms": { "uStepLen": ["cos(radians(direction)) * length / workW", "sin(radians(direction)) * length / workH"] }
    }
  ]
}
